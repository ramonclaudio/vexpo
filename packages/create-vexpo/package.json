{
  "name": "@ramonclaudio/create-vexpo",
  "version": "0.3.3",
  "description": "Scaffold a new vexpo project, an iOS app built on Expo SDK 57 and designed entirely with SwiftUI (@expo/ui), with Convex, Better Auth, and Resend wired in.",
  "keywords": [
    "apple-sign-in",
    "better-auth",
    "boilerplate",
    "convex",
    "create",
    "expo",
    "expo-sdk-57",
    "ios",
    "react-native",
    "resend",
    "scaffold",
    "starter",
    "swiftui",
    "template",
    "vexpo"
  ],
  "homepage": "https://github.com/ramonclaudio/vexpo/tree/main/packages/create-vexpo#readme",
  "bugs": {
    "url": "https://github.com/ramonclaudio/vexpo/issues"
  },
  "license": "MIT",
  "author": "Ramon Claudio <hello@ramonclaudio.com> (https://github.com/ramonclaudio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramonclaudio/vexpo.git",
    "directory": "packages/create-vexpo"
  },
  "bin": {
    "create-vexpo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "echo '(create-vexpo: no unit tests; see test:e2e)'",
    "test:e2e": "npm run build && __tests__/e2e/run.sh"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "kleur": "^4.1.5",
    "ora": "^9.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
