{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/vexpo": {
      "entry": ["__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/create-vexpo": {
      "project": ["src/**/*.ts"]
    },
    "templates/default": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/widgets/**/*.tsx",
        "convex/*.ts",
        "scripts/*.mjs",
        "__tests__/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "convex/**/*.ts"],
      "ignoreDependencies": ["vite"]
    }
  }
}
