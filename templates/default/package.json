  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~19.2.18",
    "sf-symbols-typescript": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "listUnknownPackages": true,
        "exclude": [
          "expo-modules-jsi"
        ]
      }
    }
  }
