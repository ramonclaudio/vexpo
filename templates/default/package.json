{
  "name": "vexpo",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "ios": "APP_VARIANT=development expo run:ios",
    "prebuild": "APP_VARIANT=development expo prebuild --clean",
    "eas:tf": "npx eas-cli build -p ios --profile production --auto-submit-with-profile testflight",
    "metadata:push": "npx eas-cli metadata:lint && npx eas-cli metadata:push"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.7",
    "@expo/ui": "~57.0.17",
    "better-auth": "1.6.23",
    "convex": "~1.45.0",
    "convex-helpers": "0.1.124",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-observe": "~57.0.20",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
